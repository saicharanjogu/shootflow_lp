# Public site origin. Drives metadataBase, canonical + OG URLs, robots.txt and
# the sitemap.
#
# Either leave this UNSET or give it a full absolute URL. Do not set it to an
# empty value: an empty string is not the same as unset, and it used to break
# the production build.
#
# When unset, the origin falls back in this order:
#   1. NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL  (set by Vercel — prod domain)
#   2. NEXT_PUBLIC_VERCEL_URL                     (set by Vercel — this deploy)
#   3. http://localhost:3000
# So Vercel deploys resolve to their real URL without this being set at all.
NEXT_PUBLIC_SITE_URL=https://shootflow.in

# Where every "Start Free Trial" button points.
# Falls back to the on-page "#signup" anchor when unset or blank.
NEXT_PUBLIC_SIGNUP_URL=

# Analytics (optional). See the commented block in src/app/layout.tsx.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
